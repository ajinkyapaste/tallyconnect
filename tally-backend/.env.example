PORT=
JWT_SECRET=
DATABASE_URL=
LICENSE_INTERNAL_KEY=
# How many queued sync commands the agent claims per poll (default 20).
SYNC_BATCH_SIZE=

# AI Assistant (one provider and key for all users; never sent to the app)
# AI_PROVIDER: gemini | openai | anthropic | groq | openrouter | mistral | deepseek
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: a fixed model (else the key's best model is picked)
AI_MODEL=
# Free tokens per user (used only if the 'free' row in ai_plans is missing)
AI_FREE_TOKENS=10000
# Questions per user per 10 minutes
ASSISTANT_RATE_LIMIT_PER_10_MIN=30